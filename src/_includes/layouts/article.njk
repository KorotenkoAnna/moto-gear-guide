---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}
<div class="page-hero">
  <div class="wrap">
    <p class="eyebrow">{{ section }}</p>
    <h1>{{ title }}</h1>
    {% if lead %}<p>{{ lead }}</p>{% endif %}
  </div>
</div>

<div class="article-body">
  <div class="wrap">
    <p class="breadcrumbs">
      <a href="/">Accueil</a> ›
      {% if sectionUrl %}<a href="{{ sectionUrl }}">{{ section }}</a> › {% endif %}
      {{ title }}
    </p>

    <div class="placeholder-notice">
      <strong>{{ noticeTitle or "Page en préparation." }}</strong>
      {{ noticeBody or "Cette URL est restaurée intentionnellement (bon lien externe et/ou vrai volume de recherche — voir la carte d'URL) et gardera exactement cette adresse. Le contenu définitif sera rédigé dans une prochaine étape ; pour l'instant la page ne sert qu'à fixer la structure et le design." }}
    </div>

    {% if keepReason %}
    <p class="fine-print" style="color: var(--color-ink-soft);">
      Adresse conservée à l'identique — {{ keepReason }}
    </p>
    {% endif %}

    {% if enUrl %}
    <p class="lang-switch"><a href="{{ enUrl }}">EN version →</a></p>
    {% endif %}
    {% if frUrl %}
    <p class="lang-switch"><a href="{{ frUrl }}">← Version FR</a></p>
    {% endif %}
  </div>
</div>
