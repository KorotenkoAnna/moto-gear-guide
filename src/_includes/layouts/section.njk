---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}
{% set curLang = lang or "fr" %}
<div class="page-hero">
  <div class="wrap">
    <p class="eyebrow">{% if curLang == "en" %}Section{% else %}Rubrique{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if lead %}<p>{{ lead }}</p>{% endif %}
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{% if curLang == "en" %}In this section{% else %}Dans cette rubrique{% endif %}</h2>
      <span class="muted">{% if curLang == "en" %}Content is being written — structure and design are already in place{% else %}Contenu en cours de rédaction — structure et design déjà en place{% endif %}</span>
    </div>

    {% if articles | length %}
    <div class="card-grid">
      {% for item in articles %}
      {% if item.url %}
      <a class="card" href="{{ item.url }}">
        {% if item.image %}
        <img src="{{ item.image }}" alt="{{ item.title }}" class="icon">
        {% else %}
        {{ icon(item.icon or "info") }}
        {% endif %}
        {% if not item.image %}<span class="tag">{% if curLang == "en" %}Coming soon{% else %}À venir{% endif %}</span>{% endif %}
        <h3>{{ item.title }}</h3>
        <p>{{ item.description or item.summary }}</p>
      </a>
      {% else %}
      <div class="card" style="opacity:0.6;">
        {{ icon(item.icon or "info") }}
        <span class="tag">{% if curLang == "en" %}Topic planned{% else %}Sujet prévu{% endif %}</span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% else %}
    <p class="muted">{% if curLang == "en" %}No articles published in this section yet.{% else %}Aucun article publié dans cette rubrique pour l'instant.{% endif %}</p>
    {% endif %}
  </div>
</div>
