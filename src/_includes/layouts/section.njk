---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}
{% set curLang = lang or "fr" %}
<div class="page-hero">
  <div class="wrap">
    <p class="eyebrow">{% if curLang == "en" %}Section{% else %}Rubrique{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if lead %}<p>{{ lead }}</p>{% endif %}
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{% if curLang == "en" %}In this section{% else %}Dans cette rubrique{% endif %}</h2>
      <span class="muted">{% if curLang == "en" %}Content is being written — structure and design are already in place{% else %}Contenu en cours de rédaction — structure et design déjà en place{% endif %}</span>
    </div>

    <div class="card-grid">
      {% if collectionTag %}
      {% set realArticles = collections[collectionTag] %}
      {% for item in realArticles %}
      {% if item.data.lang != "en" %}
      <a class="card" href="{{ item.url }}">
        {% if item.data.image %}
          <img src="{{ item.data.image }}" alt="{{ item.data.title }}" style="border-radius: 10px; margin-bottom: 8px; aspect-ratio: 4/3; object-fit: cover;">
        {% else %}
          {{ icon(item.data.icon or "info") }}
        {% endif %}
        {% if not item.data.published %}<span class="tag">À venir</span>{% endif %}
        <h3>{{ item.data.title }}</h3>
        <p>{{ item.data.lead }}</p>
      </a>
      {% endif %}
      {% endfor %}
      {% for item in ideas %}
      <div class="card" style="opacity:0.6;">
        {{ icon(item.icon or "info") }}
        <span class="tag">Sujet prévu</span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
      </div>
      {% endfor %}
      {% else %}
      {% for item in articles %}
      {% if item.url %}
      <a class="card" href="{{ item.url }}">
        {{ icon(item.icon or "info") }}
        <span class="tag">{% if curLang == "en" %}Coming soon{% else %}À venir{% endif %}</span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
      </a>
      {% else %}
      <div class="card" style="opacity:0.6;">
        {{ icon(item.icon or "info") }}
        <span class="tag">{% if curLang == "en" %}Topic planned{% else %}Sujet prévu{% endif %}</span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
      </div>
      {% endif %}
      {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
