{% set curLang = lang or "fr" %}
<footer class="site-footer">
  <div class="wrap">
    <div>
      <nav aria-label="{% if curLang == 'en' %}Footer navigation{% else %}Navigation de pied de page{% endif %}">
        <ul>
          {% for item in site[curLang].footerNav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <p class="fine-print">
        {{ site[curLang].footerNote }}
      </p>
    </div>
    <div class="fine-print">
      © {{ "now" | year }} {{ site.name }}
    </div>
  </div>
</footer>
<script src="/assets/js/main.js"></script>
