{% set curLang = lang or "fr" %}
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__col site-footer__col--brand">
      <p class="site-footer__brand">{{ site.name }}</p>
      <p>{{ site[curLang].footerNote }}</p>
    </div>
    <div class="site-footer__col">
      <p class="site-footer__heading">{% if curLang == "en" %}Links{% else %}Liens{% endif %}</p>
      <ul>
        {% for item in site[curLang].footerNav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <div class="site-footer__col">
      <p class="site-footer__heading">{% if curLang == "en" %}Language{% else %}Langue{% endif %}</p>
      <ul>
        <li><a href="/" {% if curLang == "fr" %}aria-current="page"{% endif %}>Français</a></li>
        <li><a href="/en/" {% if curLang == "en" %}aria-current="page"{% endif %}>English</a></li>
      </ul>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="wrap">© {{ "now" | year }} {{ site.name }}</div>
  </div>
</footer>
<script src="/assets/js/main.js"></script>
