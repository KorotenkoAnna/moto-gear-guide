{% from "partials/icons.njk" import icon %}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      {{ icon("bike", "brand-mark") }}
      <span>{{ site.name }}</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-label="Ouvrir le menu">
      ☰ Menu
    </button>
    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {% for item in site.nav %}
        <li>
          <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
