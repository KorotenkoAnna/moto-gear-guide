{% from "partials/icons.njk" import logo %}
{% set curLang = lang or "fr" %}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ site[curLang].homeUrl }}">
      {{ logo("brand-mark") }}
      <span>{{ site.name }}</span>
    </a>
    <div class="nav-controls">
      <div class="header-lang-switch" aria-label="{% if curLang == 'en' %}Switch language{% else %}Changer de langue{% endif %}">
        {% if curLang == "en" %}
        <a href="{{ translationUrl or site.fr.homeUrl }}">FR</a>
        <span class="lang-current">EN</span>
        {% else %}
        <span class="lang-current">FR</span>
        <a href="{{ translationUrl or site.en.homeUrl }}">EN</a>
        {% endif %}
      </div>
      <button class="nav-toggle" aria-expanded="false" aria-label="{% if curLang == 'en' %}Open menu{% else %}Ouvrir le menu{% endif %}">
        ☰ Menu
      </button>
      <nav class="main-nav" aria-label="{% if curLang == 'en' %}Main navigation{% else %}Navigation principale{% endif %}">
        <ul>
          {% for item in site[curLang].nav %}
          <li>
            <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>
</header>
