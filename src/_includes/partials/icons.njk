{% macro icon(name, class="icon", alt="") %}
  {% if name == "jacket" %}
  <img class="{{ class }}" src="/assets/img/photo-jacket.jpg" alt="{{ alt or 'Blouson de moto en cuir' }}" loading="lazy">
  {% elif name == "helmet" %}
  <img class="{{ class }}" src="/assets/img/photo-helmet.jpg" alt="{{ alt or 'Casque de moto' }}" loading="lazy">
  {% elif name == "glove" %}
  <img class="{{ class }}" src="/assets/img/photo-glove.jpg" alt="{{ alt or 'Gants de moto en cuir' }}" loading="lazy">
  {% elif name == "shield" %}
  <img class="{{ class }}" src="/assets/img/photo-shield.jpg" alt="{{ alt or 'Protection corporelle' }}" loading="lazy">
  {% elif name == "certificate" %}
  <img class="{{ class }}" src="/assets/img/photo-certificate.jpg" alt="{{ alt or 'Certificat de conformité' }}" loading="lazy">
  {% elif name == "compass" %}
  <img class="{{ class }}" src="/assets/img/photo-compass.jpg" alt="{{ alt or 'Guide pour choisir son équipement' }}" loading="lazy">
  {% elif name == "bike" %}
  <img class="{{ class }}" src="/assets/img/photo-bike.jpg" alt="{{ alt or 'Moto ou scooter en ville' }}" loading="lazy">
  {% else %}
  <img class="{{ class }}" src="/assets/img/photo-info.jpg" alt="{{ alt or 'À propos du projet' }}" loading="lazy">
  {% endif %}
{% endmacro %}
