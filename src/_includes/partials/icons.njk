{# Simple line-art SVG icons used as placeholder visuals (no photo-generation
   tool was available when this scaffold was built — see README "Images"
   section for how to swap these for real stock photos). #}

{% macro icon(name, class="icon") %}
  {% if name == "jacket" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 8l-8 6v22h8V20l2 16h12l2-16v16h8V14l-8-6-4 4h-8z"/>
    <path d="M20 8h8"/>
  </svg>
  {% elif name == "helmet" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M8 30c0-11 7-18 16-18s16 7 16 18"/>
    <path d="M6 30h36v4a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4z"/>
    <path d="M18 30v-6a6 6 0 0 1 12 0v6"/>
  </svg>
  {% elif name == "glove" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 44V22a4 4 0 1 1 8 0v6"/>
    <path d="M24 27V16a4 4 0 1 1 8 0v12"/>
    <path d="M32 27v-6a4 4 0 1 1 8 0v13c0 7-5 10-11 10h-4c-6 0-9-4-9-9"/>
    <path d="M16 22a4 4 0 1 0-8 0v9c0 3 1 6 3 8"/>
  </svg>
  {% elif name == "shield" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M24 5l16 6v11c0 10-7 17-16 21-9-4-16-11-16-21V11z"/>
    <path d="M17 24l5 5 9-10"/>
  </svg>
  {% elif name == "certificate" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="24" cy="18" r="11"/>
    <path d="M19 27l-4 15 9-5 9 5-4-15"/>
    <path d="M19 18l4 4 7-7"/>
  </svg>
  {% elif name == "compass" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="24" cy="24" r="18"/>
    <path d="M30 18l-5 12-12 5 5-12z"/>
  </svg>
  {% elif name == "info" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="24" cy="24" r="18"/>
    <path d="M24 22v12"/>
    <circle cx="24" cy="16" r="0.5" fill="currentColor" stroke-width="3"/>
  </svg>
  {% elif name == "mail" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="6" y="10" width="36" height="28" rx="4"/>
    <path d="M6 14l18 13 18-13"/>
  </svg>
  {% elif name == "bike" %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="34" r="7"/>
    <circle cx="37" cy="34" r="7"/>
    <path d="M11 34l8-16h10l8 16"/>
    <path d="M19 18h9l4 8"/>
    <path d="M11 34h8l6-12"/>
  </svg>
  {% else %}
  <svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <rect x="8" y="8" width="32" height="32" rx="6"/>
  </svg>
  {% endif %}
{% endmacro %}
